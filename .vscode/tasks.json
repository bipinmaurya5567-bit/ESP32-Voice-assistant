{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mokxi: Push to Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli push",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Pull from Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli pull",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Run in the simulator",
      "type": "shell",
      "command": "npx --yes @mokxi/cli run --seconds 5",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Open in the browser",
      "type": "shell",
      "command": "npx --yes @mokxi/cli open",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Compile",
      "type": "shell",
      "command": "arduino-cli compile --fqbn esp32:esp32:esp32 --output-dir build/First_blink_copy_2 First_blink_copy_2",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Upload the build to Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli upload --board esp321 --firmware build/First_blink_copy_2/First_blink_copy_2.ino.elf",
      "dependsOn": "Arduino: Compile",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload to a real board",
      "type": "shell",
      "command": "arduino-cli upload --fqbn esp32:esp32:esp32 --input-dir build/First_blink_copy_2 --port ${input:port} First_blink_copy_2",
      "dependsOn": "Arduino: Compile",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Serial port of the board (arduino-cli board list shows them)",
      "default": "/dev/ttyUSB0"
    }
  ]
}
